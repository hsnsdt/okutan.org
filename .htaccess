# okutan.org — Apache / LiteSpeed ayarları (cPanel)

# http → https ve www → çıplak alan adı (tek adımda, doğru adrese).
# Bu klasörde kendi RewriteEngine'imiz olduğu için üst klasördeki
# (ana hesap / launchshots.app) yönlendirme kuralları buraya uygulanmaz;
# "https://okutan.org/okutan.org/" hatası bu sayede biter.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://okutan.org%{REQUEST_URI} [L,R=301]

  # Kelime Bulucu: kelime ve liste sayfalarını PHP üretir (adreslerde Türkçe karakter yok; eski adresler 301 ile yönlenir)
  RewriteRule ^kelime-bulucu/kelime/([^/]+)/?$ kelime-bulucu/kelime.php?k=$1 [B,L,QSA]
  RewriteRule ^kelime-bulucu/liste/?$ kelime-bulucu/liste.php [L,QSA]
  RewriteRule ^kelime-bulucu/liste/([^/]+)/?(index\.html)?$ kelime-bulucu/liste.php?s=$1 [B,L,QSA]
  RewriteRule ^kelime-bulucu/sozluk/?$ kelime-bulucu/sozluk.php [L,QSA]
  RewriteRule ^kelime-bulucu/sozluk/(.+?)/?$ kelime-bulucu/sozluk.php?y=$1 [B,L,QSA]
  # arama sayaçları dışarıdan okunmaz
  RewriteRule ^kelime-bulucu/veri/arama/ - [F,L]
</IfModule>

# PHP hata günlükleri (cPanel her klasöre "error_log" yazar) dışarıdan okunmaz; yönetim paneli okur.
<Files "error_log">
  Require all denied
</Files>

# Google servis hesabı anahtarı gibi gizli JSON dosyaları yanlışlıkla web köküne yüklense bile indirilemesin
# (asıl yerleri web kökü dışı: ~/okutan-ozel/).
<FilesMatch "^(gsc-anahtar.*|gsc-key.*|.*service[-_]?account.*|okutan-panel-[0-9a-f]+)\.json$">
  Require all denied
</FilesMatch>

# Özel 404 sayfası
ErrorDocument 404 /404.html

# Klasör içeriğini listeleme
Options -Indexes

# Doğru karakter seti
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/webp .webp
AddType text/plain .txt

# Güvenlik başlıkları (tüm site, /kelimeler dahil — hiçbir şeyi bozmaz)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Önbellek: font ve görseller uzun, HTML kısa
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# Ortak site betikleri (alt bilgi oyun listesi + Google Tag Manager; oyunların masa sohbeti +
# "Sohbette duyur"): tarayıcı her açılışta sunucuya sorar (değişmediyse 304, birkaç yüz bayt).
# Böylece bu dosyalardaki değişiklik sayfalara dokunmadan herkese ulaşır.
<FilesMatch "^(oyunlar|okey-sohbet)\.js$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header unset Expires
  </IfModule>
</FilesMatch>
