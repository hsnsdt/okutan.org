# Yarışmanın soru bankası (cevaplar), oyun ve radyo motorları dışarıdan istenemez; index.php onları sunucu içinden okur.
<FilesMatch "^(sorular\.json|oyun\.php|radyo\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
